#!/usr/bin/env bash
# wpaperd, the wallpaper daemon. Fedora doesn't package it and crates.io stops
# at 1.0.1, so cargo builds it from the release tag.

set -euo pipefail

version=1.3.0

if [[ $(~/.cargo/bin/wpaperd --version 2>/dev/null) != "wpaperd $version" ]]; then
    cargo install --locked --force --git https://github.com/danyspin97/wpaperd --tag "$version" wpaperd wpaperctl
fi

# Not tracked: the repo is public and the images are other people's work
mkdir -p ~/Pictures/Wallpapers
