#!/usr/bin/env bash
# Fedora packages, each commented with its checklist item

set -euo pipefail

packages=(
    git-delta  # 2. git pager
    zsh        # 4. login shell
    fzf        # 5. Ctrl+R history search
)

if ! rpm -q "${packages[@]}" >/dev/null; then
    sudo dnf install -y "${packages[@]}"
fi
