#!/usr/bin/env bash
# Fedora packages, each commented with its checklist item

set -euo pipefail

packages=(
    git-delta                # 2. git pager
    zsh                      # 4. login shell
    fzf                      # 5. Ctrl+R history search
    zsh-autosuggestions      # 7. grey suggestions from history
    zsh-syntax-highlighting  # 7. colours on the command line
    zoxide                   # 9. z jumps to visited folders
    bsdtar                   # 10. x extracts any archive
    neovim                   # 11. EDITOR
    cargo                    # 11. cargo install for CLI tools
)

if ! rpm -q "${packages[@]}" >/dev/null; then
    sudo dnf install -y "${packages[@]}"
fi
